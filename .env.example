# Telegram Bot Easy - Environment Variables
# Copy this file to .env and fill in your credentials

# ═══════════════════════════════════════════════════════════
#  REQUIRED - Get these from Telegram
# ═══════════════════════════════════════════════════════════

# Bot Token - Get from @BotFather on Telegram
# 1. Message @BotFather
# 2. Send /newbot
# 3. Follow prompts and copy the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram User ID - Get from @userinfobot
# 1. Message @userinfobot on Telegram
# 2. It will reply with your numeric ID
TELEGRAM_BOT_USER_ID=123456789

# API ID and Hash - Get from my.telegram.org
# 1. Go to https://my.telegram.org
# 2. Sign in with your phone number
# 3. Click "API Development Tools"
# 4. Create a new application
# 5. Copy api_id and api_hash
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# ═══════════════════════════════════════════════════════════
#  OPTIONAL - Add your own API keys for custom integrations
# ═══════════════════════════════════════════════════════════

# Example: Weather API (if using a paid weather service)
# WEATHER_API_KEY=your_weather_api_key

# Example: Custom service
# MY_SERVICE_API_KEY=your_service_api_key

# Example: Database (if using Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_key
